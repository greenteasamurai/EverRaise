# EverRaise Backend Environment Configuration

# ====== Database Configuration ======
DATABASE_URL=sqlite+aiosqlite:///./everraise.db
# For PostgreSQL use:
# DATABASE_URL=postgresql://user:password@localhost:5432/everraise

# ====== Security Settings ======
# Generate a secure random key: Run `openssl rand -hex 32` in terminal
SECRET_KEY=redacted_for_security
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30

# ====== LLM Configuration ======
OLLAMA_BASE_URL=http://localhost:11434
DEFAULT_LLM_MODEL=llama3:8b
EMBEDDING_MODEL=nomic-embed-text
VECTOR_STORE_PATH=./data/vector_store
MAX_CONTEXT_DOCUMENTS=10

# ====== Redis Queue Configuration ======
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_DB=0
REDIS_PASSWORD=

# ====== Gmail API Configuration ======
# Create OAuth 2.0 credentials at https://console.cloud.google.com/
GOOGLE_CLIENT_ID=redacted.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=redacted
GMAIL_API_TOKEN_FILE=C:/EverRaise-Secure/tokens/gmail_token.json
GMAIL_API_CREDENTIALS_FILE=C:/EverRaise-Secure/credentials/gmail_credentials.json

# ====== Application Settings ======
ENVIRONMENT=development  # development, staging, production
DEBUG=true
LOG_LEVEL=INFO
BACKEND_CORS_ORIGINS=["http://localhost:3000","http://localhost:5173","http://127.0.0.1:3000","http://127.0.0.1:5173"]

# API Configuration
API_V1_STR=/api/v1
PROJECT_NAME=EverRaise
SERVER_HOST=http://localhost:8000
SERVER_PORT=8000

# Report Generation Settings
REPORT_CACHE_EXPIRY=3600  # seconds
MAX_REPORT_QUEUE_SIZE=50
REPORT_WORKER_TIMEOUT=600  # seconds
ENABLE_REPORT_SCHEDULING=True
ENABLE_ADVANCED_ANALYTICS=True
ENABLE_PRIVATE_LLM=False

# App Settings
APP_ENV=development
ALLOWED_HOSTS=localhost,127.0.0.1

# Authentication
AUTH_TOKEN_EXPIRE_MINUTES=1440
AUTH_SECRET_KEY=redacted_for_security

# API Configuration
API_PREFIX=/api/v1

# External Services
SLACK_API_TOKEN=redacted
SLACK_SIGNING_SECRET=redacted

# Google API Settings
GMAIL_API_ENABLED=true

# Security Settings
ENCRYPTION_KEY_PATH=C:/EverRaise-Secure/encryption/master.key
PII_DETECTION_ENABLED=true
DATA_RETENTION_DAYS=90

# Logging
LOG_FILE=logs/everraise.log

# Testing
TEST_EMAIL=test@example.com

# API Configuration
SERVER_NAME=EverRaise API
SERVER_HOST=http://localhost:8000

# CORS Configuration
CORS_ORIGINS=["http://localhost:3000", "http://localhost:8000", "http://localhost:5173", "http://localhost:5174", "http://localhost:5175", "http://localhost:5176", "http://localhost:5177", "http://localhost:5178"]

# Database Configuration
POSTGRES_SERVER=localhost
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=everraise
POSTGRES_PORT=5432

# Redis Configuration
REDIS_URL="redis://localhost:6379/0"
CELERY_BROKER_URL=redis://localhost:6379/0
CELERY_RESULT_BACKEND=redis://localhost:6379/0

# Vector Database Configuration
PINECONE_API_KEY=your-pinecone-api-key
PINECONE_ENVIRONMENT=us-west1-gcp
PINECONE_INDEX_NAME=everraise-embeddings

# LLM Configuration
OPENAI_API_KEY=your-openai-api-key
GOOGLE_API_KEY=your-google-api-key
LLM_DEFAULT_MODEL=gpt-4
LLM_TIMEOUT=60
LLM_MAX_TOKENS=1000
LLM_TEMPERATURE=0.2
OLLAMA_MODEL=llama2

# Email Configuration
SMTP_TLS=True
SMTP_PORT=587
SMTP_HOST=smtp.example.com
SMTP_USER=user@example.com
SMTP_PASSWORD=password
EMAILS_FROM_EMAIL=support@everraise.app
EMAILS_FROM_NAME=EverRaise Support

# OAuth2 Configuration
MICROSOFT_CLIENT_ID=your-microsoft-client-id
MICROSOFT_CLIENT_SECRET=your-microsoft-client-secret

# Gmail API Configuration
GMAIL_API_SCOPES=https://www.googleapis.com/auth/gmail.readonly

# Security & Monitoring
SENTRY_DSN=https://example@sentry.io/123456

# Application Features
ENABLE_REPORT_SCHEDULING=True
ENABLE_ADVANCED_ANALYTICS=True
ENABLE_PRIVATE_LLM=False 