# EverRaise Backend Environment Configuration
# IMPORTANT: Copy this file to .env and fill in your own values
# DO NOT commit the .env file to version control

# ====== Database Configuration ======
DATABASE_URL=sqlite+aiosqlite:///./everraise.db
# For PostgreSQL use:
# DATABASE_URL=postgresql://user:password@localhost:5432/everraise

# ====== Security Settings ======
# Generate a secure random key: Run `openssl rand -hex 32` in terminal
SECRET_KEY=your_secret_key_here
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7

# ====== Redis Configuration ======
REDIS_URL=redis://localhost:6379/0
REDIS_PASSWORD=

# ====== LLM Configuration ======
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=llama2
OLLAMA_TIMEOUT=60
MODEL_TEMPERATURE=0.7
MODEL_MAX_TOKENS=2048

# ====== Gmail API Configuration ======
# Create OAuth 2.0 credentials at https://console.cloud.google.com/
GOOGLE_CLIENT_ID=your_google_client_id_here.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your_google_client_secret_here
GMAIL_API_TOKEN_FILE=C:/EverRaise-Secure/tokens/gmail_token.json
GMAIL_API_CREDENTIALS_FILE=C:/EverRaise-Secure/credentials/gmail_credentials.json

# ====== Application Settings ======
ENVIRONMENT=development  # development, staging, production
DEBUG=true
LOG_LEVEL=INFO
BACKEND_CORS_ORIGINS=["http://localhost:3000","http://localhost:5173","http://127.0.0.1:3000","http://127.0.0.1:5173"]

# API Configuration
SERVER_NAME=EverRaise API
SERVER_HOST=http://localhost:8000

# CORS Configuration
CORS_ORIGINS=["http://localhost:3000", "http://localhost:8000"]

# Database Configuration
POSTGRES_SERVER=localhost
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=everraise
POSTGRES_PORT=5432

# Redis Configuration
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_DB=0

# Vector Database Configuration
PINECONE_API_KEY=your-pinecone-api-key
PINECONE_ENVIRONMENT=us-west1-gcp
PINECONE_INDEX_NAME=everraise-embeddings

# LLM Configuration
OPENAI_API_KEY=your-openai-api-key
GOOGLE_API_KEY=your-google-api-key
LLM_DEFAULT_MODEL=gpt-4
LLM_TIMEOUT=60
LLM_MAX_TOKENS=1000
LLM_TEMPERATURE=0.2

# Email Configuration
SMTP_TLS=True
SMTP_PORT=587
SMTP_HOST=smtp.example.com
SMTP_USER=user@example.com
SMTP_PASSWORD=password
EMAILS_FROM_EMAIL=support@everraise.app
EMAILS_FROM_NAME=EverRaise Support

# OAuth2 Configuration
MICROSOFT_CLIENT_ID=your-microsoft-client-id
MICROSOFT_CLIENT_SECRET=your-microsoft-client-secret
SLACK_CLIENT_ID=your-slack-client-id
SLACK_CLIENT_SECRET=your-slack-client-secret

# Gmail API Configuration
GMAIL_API_SCOPES=https://www.googleapis.com/auth/gmail.readonly

# Security & Monitoring
SENTRY_DSN=
ENCRYPTION_KEY=your-encryption-key

# Application Features
ENABLE_REPORT_SCHEDULING=True
ENABLE_ADVANCED_ANALYTICS=True
ENABLE_PRIVATE_LLM=False

# App Settings
APP_ENV=development
ALLOWED_HOSTS=localhost,127.0.0.1

# Authentication
AUTH_TOKEN_EXPIRE_MINUTES=1440
AUTH_SECRET_KEY=your_auth_secret_key_here

# API Configuration
API_PREFIX=/api/v1
API_V1_STR=/api/v1

# External Services
SLACK_API_TOKEN=your_slack_token_here
SLACK_SIGNING_SECRET=your_slack_signing_secret_here

# Google API Settings
GMAIL_API_ENABLED=true

# Security Settings
ENCRYPTION_KEY_PATH=C:/EverRaise-Secure/encryption/master.key
PII_DETECTION_ENABLED=true
DATA_RETENTION_DAYS=90

# Logging
LOG_FILE=logs/everraise.log

# Testing
TEST_EMAIL=test@example.com 